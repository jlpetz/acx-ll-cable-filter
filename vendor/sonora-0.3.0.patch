noise-filter's patch to crates.io sonora 0.3.0 (SHA-256 d461e6c9ad112f8728919387a4bc5639fd28631f2070171efad38676e907edd8):
its FTZ/DAZ guard becomes the `denormal-guard` cargo feature, off by default (TODO 10, vendor/README.md). This is the
whole difference between the released crate and vendor/sonora-0.3.0. Apply it from the unpacked crate's root with
`patch -p1`.

diff -ruN a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -34,6 +34,9 @@
 repository = "https://github.com/dignifiedquire/sonora"
 
 [features]
+# noise-filter vendor patch: FTZ/DAZ for each process_* call
+# (src/denormal_disabler.rs), off by default.
+denormal-guard = []
 examples = [
     "dep:anyhow",
     "dep:clap",
